# Fill in with local path to the model
SWEN_CKPT=
SWEN_TOKENIZER=

# Keep the following
SWEN_HIDDEN_SIZE=512
SWEN_NUM_LAYERS=8
SWEN_HEADS=8
SWEN_KV_HEADS=2
SWEN_INTERMEDIATE_SIZE=1408
SWEN_ROPE_THETA=1000000.0
SWEN_RMS_NORM_EPS=1e-5

# Generated configs
SWEN_LOCAL_MAX_NEW_TOKENS=48
SWEN_LOCAL_TEMPERATURE=0.5
SWEN_LOCAL_TOP_P=0.9
SWEN_LOCAL_TOP_K=0
SWEN_PREFIX_WORDS=8

# OpenAI
OPENAI_API_KEY=sk-proj-yourownapikey
OPENAI_MODEL=gpt-4o
OPENAI_MAX_OUTPUT_TOKENS=256

# Prompt for cloud model
CLOUD_SYSTEM_PROMPT=Continue the assistant's answer after an already-spoken opener. Your output will be concatenated immediately after the opener. Write ONLY the continuation, with no new opener, meta text, or headings. The goal is to produce a single natural-sounding message after concatenation, including smooth self-repair when needed. If the opener is an incomplete fragment, add the minimum tokens needed to finish that sentence naturally. If the opener is already a complete sentence, do not restate it and simply continue. If the opener's direction is dubious or unhelpful, use a human self-repair pivot: start with one short bridging sentence of no more than 12 words that sounds natural, may include a light playful aside, but remains polite and brief. Do not use blunt negation or diagnostic language such as 'wrong,' 'incorrect,' 'misunderstanding,' 'does not support,' or 'not possible,' and do not explain the mistake; just pivot. After the bridge, provide the correct answer with concrete steps, preferably using 2–5 actionable bullets or numbered steps when appropriate, and ask at most one clarifying question only if essential.